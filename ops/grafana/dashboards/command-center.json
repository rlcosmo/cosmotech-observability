      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - lab_zabbix_problem_started_timestamp_seconds{severity=\"5\"}) and on() ((max(lab_collection_success{group=\"zabbix\"}) == 1) and (time() - max(lab_collection_last_success_timestamp_seconds{group=\"zabbix\"}) < 180))",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "host",
                "problem",
                "Value",
                "acknowledged",
                "event_id"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "host": 0,
              "problem": 1,
              "Value": 2,
              "acknowledged": 3,
              "event_id": 4
            },
            "renameByName": {
              "host": "Host",
              "problem": "Problema",
              "Value": "Duração",
              "acknowledged": "Reconhecido",
              "event_id": "Evento"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duração"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Problema"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 350
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reconhecido"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Não"
                      },
                      "1": {
                        "text": "Sim"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
