      },
      "options": {
        "mode": "markdown",
        "content": "**COMMAND CENTER** · Incidentes abertos por prioridade. Reconhecidos continuam visíveis; eventos resolvidos ou suprimidos ficam fora da visão. Atualização automática."
      },
      "id": 1
    },
    {
      "type": "row",
      "title": "RESPOSTA IMEDIATA · Disaster e High",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Disaster",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 4
      },
      "description": "Quantidade de eventos abertos, não suprimidos e com trigger/host monitorado. Sem coleta válida, exibe SEM COLETA.",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(lab_zabbix_problem_count{severity=\"5\"}) and on() ((max(lab_collection_success{group=\"zabbix\"}) == 1) and (time() - max(lab_collection_last_success_timestamp_seconds{group=\"zabbix\"}) < 180))) or on() (-1 * (vector(1) unless on() ((max(lab_collection_success{group=\"zabbix\"}) == 1) and (time() - max(lab_collection_last_success_timestamp_seconds{group=\"zabbix\"}) < 180))))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "SEM COLETA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#299C46"
              },
              {
                "value": 1,
                "color": "#E02F44"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "SEM COLETA",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "SEM COLETA",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "id": 4
    },
