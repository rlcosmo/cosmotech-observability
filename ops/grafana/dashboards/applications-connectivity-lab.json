    {
      "id": 6,
      "type": "logs",
      "title": "Chamadas internas, externas e recebidas • logs correlacionados",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"orders-api|orders-worker\",container=~\"orders-api|orders-worker\"} | json | event=~\"synthetic_.*\"",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Duração das conexões",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by(service,direction) (avg_over_time({namespace=~\"orders-api|orders-worker\",container=~\"orders-api|orders-worker\"} | json | event=\"synthetic_connection\" | unwrap duration_ms | __error__=\"\" [5m]))",
          "queryType": "range",
          "legendFormat": "{{service}} • {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
