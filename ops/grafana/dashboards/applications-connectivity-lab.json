{
  "uid": "applications-connectivity-lab",
  "title": "Aplicações | Logs e conexões",
  "schemaVersion": 39,
  "version": 0,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "cosmotech",
    "apm",
    "logs"
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Conexões reais a cada 5 minutos",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Cada pod faz chamada interna ao serviço par e GET HTTPS em `example.com` a cada **300 segundos**. Uma Lambda fora da VPC chama os dois hosts públicos pelo Scheduler. Logs JSON incluem status, duração e trace ID. As chamadas sintéticas não criam pedidos.\n\nOs spans estão no Tempo e no APM do Zabbix; use o `trace_id` do log para correlacionar. Os contadores abaixo mostram os últimos 15 minutos."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "orders-api • internal HTTP 200",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"orders-api\",container=\"orders-api\"} | json | event=\"synthetic_connection\" | direction=\"internal\" | status_code=200 | __error__=\"\" [15m]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Sem dados"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "orders-api • external HTTP 200",
