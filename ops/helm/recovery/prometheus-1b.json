{
  "prometheus": {
    "prometheusSpec": {
      "retention": "30d",
      "retentionSize": "8GB",
      "resources": {
        "requests": {
          "cpu": "150m",
          "memory": "350Mi"
        },
        "limits": {
          "cpu": "1",
          "memory": "1Gi"
        }
      },
      "nodeSelector": {
        "kubernetes.io/os": "linux",
        "topology.kubernetes.io/zone": "us-east-1b"
      },
      "volumes": [
        {
          "name": "recovered-data",
          "persistentVolumeClaim": {
            "claimName": "cosmotech-recovery-prometheus-20261111"
          }
        }
      ],
      "containers": [
        {
          "name": "prometheus",
          "volumeMounts": [
            {
              "name": "recovered-data",
              "mountPath": "/prometheus"
            }
          ]
        },
        {
          "name": "config-reloader",
          "resources": {
            "requests": {
              "cpu": "10m",
              "memory": "16Mi"
            },
            "limits": {
              "cpu": "100m",
              "memory": "128Mi"
            }
          }
        }
      ],
      "initContainers": [
        {
          "name": "init-config-reloader",
          "resources": {
            "requests": {
              "cpu": "10m",
              "memory": "16Mi"
            },
            "limits": {
              "cpu": "100m",
              "memory": "128Mi"
            }
          }
        }
      ],
      "storageSpec": {
        "emptyDir": {},
        "volumeClaimTemplate": null
      }
    }
  }
}
