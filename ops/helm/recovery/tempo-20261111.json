{
  "persistence": {
    "enabled": false
  },
  "tempo": {
    "retention": "720h",
    "resources": {
      "requests": {
        "cpu": "50m",
        "memory": "96Mi"
      },
      "limits": {
        "cpu": "500m",
        "memory": "512Mi"
      }
    },
    "extraVolumeMounts": [
      {
        "name": "recovered-storage",
        "mountPath": "/var/tempo"
      }
    ]
  },
  "extraVolumes": [
    {
      "name": "recovered-storage",
      "persistentVolumeClaim": {
        "claimName": "cosmotech-recovery-tempo-20261111"
      }
    }
  ],
  "nodeSelector": {
    "kubernetes.io/hostname": null,
    "kubernetes.io/os": "linux",
    "topology.kubernetes.io/zone": "us-east-1b"
  }
}
