{
  "persistence": {
    "enabled": false
  },
  "tempo": {
    "retention": "720h",
    "resources": {
      "requests": {
        "cpu": "50m",
        "memory": "96Mi"
      },
      "limits": {
        "cpu": "500m",
        "memory": "512Mi"
      }
    },
    "extraVolumeMounts": [
      {
        "name": "recovered-storage",
        "mountPath": "/var/tempo"
      }
    ]
  },
  "extraVolumes": [
    {
      "name": "recovered-storage",
      "persistentVolumeClaim": {
        "claimName": "tempo-p0-1b"
      }
    }
  ],
  "nodeSelector": {
    "kubernetes.io/hostname": "ip-10-20-12-35.ec2.internal"
  }
}